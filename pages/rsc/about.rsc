c:["$","section",null,{"className":"mx-auto grid max-w-7xl gap-6 px-5 pb-20 sm:grid-cols-2 sm:px-8","children":[["$","article","Written recipes, every time",{"className":"rounded-[1.75rem] bg-white p-8 ring-1 ring-ink/5","children":[["$","h2",null,{"className":"font-display text-2xl font-medium","children":"Written recipes, every time"}],["$","p",null,{"className":"mt-3 leading-relaxed text-ink/70","children":"Every bowl and sauce follows a documented kitchen procedure, with weighed portions — so your favourite tastes the same every day."}]]}],["$","article","Small batches, dated and chilled",{"className":"rounded-[1.75rem] bg-white p-8 ring-1 ring-ink/5","children":[["$","h2",null,{"className":"font-display text-2xl font-medium","children":"Small batches, dated and chilled"}],["$","p",null,{"className":"mt-3 leading-relaxed text-ink/70","children":"Dressings, pesto and roasted components are made in small dated batches and held at 4°C or below. Nothing is served past its use-by."}]]}],["$","article","Packed to travel",{"className":"rounded-[1.75rem] bg-white p-8 ring-1 ring-ink/5","children":[["$","h2",null,{"className":"font-display text-2xl font-medium","children":"Packed to travel"}],["$","p",null,{"className":"mt-3 leading-relaxed text-ink/70","children":"Dressings and crunchy toppings go in separate sealed cups, inside rigid bowls, so salads arrive crisp — not soggy."}]]}],["$","article","You choose, every day",{"className":"rounded-[1.75rem] bg-white p-8 ring-1 ring-ink/5","children":[["$","h2",null,{"className":"font-display text-2xl font-medium","children":"You choose, every day"}],["$","p",null,{"className":"mt-3 leading-relaxed text-ink/70","children":"Our logo says it: you choose everyday. Clear calories, allergens and ingredients on every dish, so you can eat the way you want."}]]}]]}]
