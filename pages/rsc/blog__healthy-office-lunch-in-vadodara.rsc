6:["$","$L16",null,{"initialMenu":{"acceptingOrders":true,"orderingHours":{"opens":"11:00","closes":"20:00"},"razorpayKeyId":"rzp_live_TrpPs1JknB3nDC","gstRate":5,"packagingChargePerOrder":0,"deliveryCharge":0,"items":[{"id":"chicken-caesar","slug":"classic-chicken-caesar-salad","name":"Classic Chicken Caesar Salad","description":"Grilled chicken steak, hard-boiled eggs, crisp lettuce, cherry tomatoes, shaved parmesan and crunchy garlic croutons tossed in a signature Caesar dressing.","category":"Protein Salads","price":550,"imageUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fchicken-caesar-cutout.webp?alt=media","photoUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fchicken-caesar.webp?alt=media","ogImageUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fchicken-caesar-og.jpg?alt=media","available":true,"diet":"nonveg","allergens":["egg","milk","mustard","gluten"],"nutrition":{"calories":645},"ingredients":["Grilled chicken steak","Hard-boiled eggs","Lettuce","Cherry tomatoes","Parmesan cheese","Garlic croutons","Caesar dressing"]},{"id":"asian-rice-noodle","slug":"asian-noodle-salad","name":"Asian Noodle Salad","description":"Rice noodles, shredded purple cabbage, carrots, sliced onions, crunchy peanuts, fresh mint and coriander in a toasted sesame-soy vinaigrette.","category":"Fresh Salads","price":460,"imageUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fasian-rice-noodle-cutout.webp?alt=media","photoUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fasian-rice-noodle.webp?alt=media","ogImageUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fasian-rice-noodle-og.jpg?alt=media","available":true,"diet":"veg","allergens":["soy","sesame","peanuts"],"nutrition":{"calories":435},"ingredients":["Rice noodles","Purple cabbage","Carrots","Sliced onions","Peanuts","Fresh mint","Fresh coriander","Sesame-soy vinaigrette"]},{"id":"chana-moong","slug":"desi-mango-sprout-salad","name":"Desi Mango & Sprout Salad","description":"Protein-packed chana and moong sprouts tossed with fresh mango, cucumber, tomatoes, chaat masala and a sweet-spicy mango-jalapeño dressing.","category":"Fresh Salads","price":460,"imageUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fchana-moong-cutout.webp?alt=media","photoUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fchana-moong.webp?alt=media","ogImageUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fchana-moong-og.jpg?alt=media","available":true,"diet":"veg","allergens":[],"nutrition":{"protein":8,"calories":435},"ingredients":["Chana","Moong sprouts","Fresh mango","Cucumber","Tomatoes","Chaat masala","Mango-jalapeño dressing"]},{"id":"caprese","slug":"salad-caprese","name":"Salad Caprese","description":"Fresh buffalo mozzarella, ripe tomatoes, peppery arugula and basil, drizzled with walnut-basil pesto, balsamic glaze and toasted nuts.","category":"Fresh Salads","price":550,"imageUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fcaprese-cutout.webp?alt=media","photoUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fcaprese.webp?alt=media","ogImageUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fcaprese-og.jpg?alt=media","available":true,"diet":"veg","allergens":["milk","tree nuts (walnut, pine nut)"],"nutrition":{"protein":28,"calories":650},"ingredients":["Buffalo mozzarella","Tomatoes","Arugula","Basil","Walnut-basil pesto","Balsamic glaze","Toasted nuts"]},{"id":"greek-hummus","slug":"greek-hummus-salad","name":"Greek Hummus Salad","description":"Creamy house-made hummus topped with crunchy cucumber, lettuce, cherry tomatoes, olives, onion, pomegranate and mint, dusted with za’atar and sumac, finished with sesame oil and crisp lavash.","category":"Fresh Salads","price":550,"imageUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fgreek-hummus-cutout.webp?alt=media","photoUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fgreek-hummus.webp?alt=media","ogImageUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fgreek-hummus-og.jpg?alt=media","available":true,"diet":"veg","allergens":["sesame","gluten"],"nutrition":null,"ingredients":["Hummus","Cucumber","Lettuce","Cherry tomatoes","Olives","Onion","Pomegranate","Mint","Za’atar","Sumac","Lavash","Sesame oil"]},{"id":"potato-apple","slug":"roasted-potato-apple-salad","name":"Roasted Potato & Apple Salad","description":"Herb-roasted potatoes, crisp apples, lettuce, cherry tomatoes and walnuts folded in a tangy French egg gribiche sauce with capers and gherkins.","category":"Fresh Salads","price":370,"imageUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fpotato-apple-cutout.webp?alt=media","photoUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fpotato-apple.webp?alt=media","ogImageUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fpotato-apple-og.jpg?alt=media","available":true,"diet":"egg","allergens":["egg","tree nuts (walnut)","milk","mustard"],"nutrition":{"protein":8,"calories":270},"ingredients":["Roasted potatoes","Apples","Lettuce","Cherry tomatoes","Walnuts","French egg gribiche sauce","Capers","Gherkins","Herbs"]},{"id":"potato-apple-eggless","slug":"roasted-potato-apple-salad-eggless","name":"Roasted Potato & Apple Salad (Eggless)","description":"Herb-roasted potatoes, crisp apples, lettuce, cherry tomatoes and walnuts with a tangy eggless gribiche made on creamy hung curd, with gherkins and herbs.","category":"Fresh Salads","price":370,"imageUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fpotato-apple-cutout.webp?alt=media","photoUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fpotato-apple.webp?alt=media","ogImageUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fpotato-apple-og.jpg?alt=media","available":true,"diet":"veg","allergens":["tree nuts (walnut)","milk","mustard"],"nutrition":null,"ingredients":["Roasted potatoes","Apples","Lettuce","Cherry tomatoes","Walnuts","Eggless hung curd gribiche sauce","Gherkins","Herbs"]},{"id":"chocolate-fruit-bowl","slug":"dark-chocolate-fruit-bowl","name":"Dark Chocolate Fruit Bowl","description":"Velvety hung curd blended with dark chocolate compound, cocoa, orange zest and honey, topped with seasonal exotic fruits and granola or nuts.","category":"Fruit & Dessert Bowls","price":370,"imageUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fchocolate-fruit-bowl-cutout.webp?alt=media","photoUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fchocolate-fruit-bowl.webp?alt=media","ogImageUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fchocolate-fruit-bowl-og.jpg?alt=media","available":true,"diet":"veg","allergens":["milk","gluten (granola)","nuts (granola — check label)"],"nutrition":{"protein":9,"calories":400},"ingredients":["Hung curd","dark chocolate compound","cocoa","orange zest","honey","seasonal exotic fruits","granola/nuts"]}]},"children":"$L17"}]
18:T81c,{"@context":"https://schema.org","@graph":[{"@type":"BlogPosting","@id":"https://leafli.in/blog/healthy-office-lunch-in-vadodara#article","mainEntityOfPage":{"@type":"WebPage","@id":"https://leafli.in/blog/healthy-office-lunch-in-vadodara"},"headline":"Healthy Office Lunch in Vadodara: Ideas for Desk & Team","description":"Plan a healthy office lunch in Vadodara that beats the 3 pm slump: what to eat, how to order for a team, and delivery to Alkapuri, Race Course and beyond.","image":["https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fchicken-caesar.webp?alt=media"],"datePublished":"2026-10-25T03:00:00.000Z","dateModified":"2026-10-25T03:00:00.000Z","author":{"@type":"Person","name":"Leafli Kitchen Team","description":"The chefs behind Leafli's bowls. We write every recipe down, weigh every portion and test what travels well — this blog shares what we've learned.","url":"https://leafli.in/about"},"publisher":{"@id":"https://leafli.in/#organization"},"articleSection":"Vadodara guides","keywords":"healthy office lunch in Vadodara, corporate lunch delivery Vadodara, team lunch Vadodara, lunch delivery Alkapuri, office lunch, Vadodara, corporate, productivity","wordCount":843,"inLanguage":"en-IN"},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is a good healthy lunch for the office?","acceptedAnswer":{"@type":"Answer","text":"A meal with plenty of vegetables, a solid portion of protein, a moderate amount of slow carbohydrates and little fried food — such as a well-built salad bowl or a dal-sabzi-roti meal with salad."}},{"@type":"Question","name":"Can Leafli deliver lunch for my whole team?","acceptedAnswer":{"@type":"Answer","text":"Yes. We deliver team lunches and bulk orders to offices across Vadodara. Contact us a day ahead for large orders so we can schedule them."}},{"@type":"Question","name":"What time are subscription lunches delivered?","acceptedAnswer":{"@type":"Answer","text":"Subscription lunches arrive between 12 and 2 pm on the days you choose, anywhere in Vadodara."}}]}]}7:["$","main",null,{"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$18"}}],["$","article",null,{"children":[["$","header",null,{"className":"bg-cream-100 pt-32 pb-12 md:pt-40","children":["$","div",null,{"className":"mx-auto max-w-3xl px-5 sm:px-8","children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://leafli.in/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Blog\",\"item\":\"https://leafli.in/blog\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Vadodara guides\",\"item\":\"https://leafli.in/blog/category/vadodara-guides\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Healthy Office Lunch in Vadodara: Ideas That Beat the 3 pm Slump\",\"item\":\"https://leafli.in/blog/healthy-office-lunch-in-vadodara\"}]}]}"}}],["$","nav",null,{"aria-label":"Breadcrumb","className":"text-sm text-ink/50","children":["$","ol",null,{"className":"flex flex-wrap items-center gap-1.5","children":[["$","li","/",{"className":"flex items-center gap-1.5","children":[false,["$","$L19",null,{"href":"/","className":"hover:text-leaf-700","children":"Home"}]]}],["$","li","/blog",{"className":"flex items-center gap-1.5","children":[["$","span",null,{"aria-hidden":true,"children":"/"}],["$","$L19",null,{"href":"/blog","className":"hover:text-leaf-700","children":"Blog"}]]}],"$L1a","$L1b"]}]}]],"$L1c","$L1d","$L1e"]}]}],"$L1f","$L20","$L21","$L22"]}],"$L23"]}]
