1d:["$","p",null,{"className":"mt-5 text-xl leading-relaxed text-ink/65","children":"Heavy lunches lead to sleepy afternoons. Here's how to plan a healthy office lunch in Vadodara — for yourself or your whole team — that keeps energy steady until evening."}]
