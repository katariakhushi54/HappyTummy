7:Tdf3,{"@context":"https://schema.org","@graph":[{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Where do you deliver?","acceptedAnswer":{"@type":"Answer","text":"We deliver across Vadodara city from our cloud kitchen in Akota — including Alkapuri, Old Padra Road, Race Course, Gotri, Vasna-Bhayli, Manjalpur, Karelibaug, Fatehgunj, Sama, Nizampura and Waghodia Road. Enter your address at checkout to confirm delivery for your street."}},{"@type":"Question","name":"What are your opening hours?","acceptedAnswer":{"@type":"Answer","text":"We take orders from 11 am to 9 pm, every day of the week. Subscription lunches arrive between 12 and 2 pm and dinners between 7 and 9 pm."}},{"@type":"Question","name":"Where can I get healthy food in Vadodara?","acceptedAnswer":{"@type":"Answer","text":"Leafli is a Vadodara kitchen dedicated to salads and healthy bowls — high-protein vegetarian salads, chicken salads and fruit bowls with calories and allergens listed for every dish. Order online at leafli.in for delivery anywhere in Vadodara."}},{"@type":"Question","name":"Can I order salads for my office in Vadodara?","acceptedAnswer":{"@type":"Answer","text":"Yes. We deliver team lunches and bulk salad orders to offices across Vadodara. Contact us a day ahead for large orders so we can schedule them."}},{"@type":"Question","name":"How long does delivery take?","acceptedAnswer":{"@type":"Answer","text":"Most orders are assembled within 15–20 minutes and then handed to a rider. You can track your rider live from your order page."}},{"@type":"Question","name":"Can I order on Zomato?","acceptedAnswer":{"@type":"Answer","text":"Yes, Leafli is on Zomato too. Ordering directly on leafli.in gets you subscriptions and saved addresses."}},{"@type":"Question","name":"How do I pay?","acceptedAnswer":{"@type":"Answer","text":"Pay online with UPI, cards, netbanking or wallets through Razorpay, or choose pay on delivery."}},{"@type":"Question","name":"Why are dressings packed separately?","acceptedAnswer":{"@type":"Answer","text":"So nothing goes soggy on the way. Toss the dressing in just before you eat for the best crunch."}},{"@type":"Question","name":"How fresh is the food?","acceptedAnswer":{"@type":"Answer","text":"Bowls are assembled to order. Sauces and roasted components are made in small dated batches, kept at 4°C or below, and never used past their use-by."}},{"@type":"Question","name":"Do you list allergens?","acceptedAnswer":{"@type":"Answer","text":"Yes — every dish page lists its allergens. Our kitchen also handles nuts, peanuts, sesame, soy, gluten, egg, dairy and mustard, so tell us about allergies in your order notes."}},{"@type":"Question","name":"Do you have vegetarian options?","acceptedAnswer":{"@type":"Answer","text":"Most of our menu is vegetarian, clearly marked with the green veg symbol. Egg and non-veg dishes are marked too."}},{"@type":"Question","name":"How do subscriptions work?","acceptedAnswer":{"@type":"Answer","text":"Buy a pack of bowls, pick your delivery days and slot, and we deliver one bowl per delivery day. Choose your bowl for any day or let the chef rotate the menu."}},{"@type":"Question","name":"Can I pause or skip?","acceptedAnswer":{"@type":"Answer","text":"Yes — skip a day, pause your plan or change your bowl until 9 pm the day before. Pausing extends your plan's validity."}},{"@type":"Question","name":"What happens to unused bowls?","acceptedAnswer":{"@type":"Answer","text":"Bowls must be used within the plan's validity period. See our refund policy for cancellations."}}]}]}0:{"P":null,"b":"CJZWBJWXS687Vqr_e_wAa","p":"","c":["","faq"],"i":false,"f":[[["",{"children":["(site)",{"children":["faq",{"children":["__PAGE__",{}]}]}]},"$undefined","$undefined",true],["",["$","$1","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/caf7f6b6b6240e00.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/c