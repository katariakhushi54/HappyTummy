e":"State","name":"Gujarat"}},{"@type":"Place","name":"Akota, Vadodara"},{"@type":"Place","name":"Alkapuri, Vadodara"},{"@type":"Place","name":"Old Padra Road, Vadodara"},{"@type":"Place","name":"Race Course, Vadodara"},{"@type":"Place","name":"Productivity Road, Vadodara"},{"@type":"Place","name":"Gotri, Vadodara"},{"@type":"Place","name":"Vasna-Bhayli, Vadodara"},{"@type":"Place","name":"Sevasi, Vadodara"},{"@type":"Place","name":"Manjalpur, Vadodara"},{"@type":"Place","name":"Makarpura, Vadodara"},{"@type":"Place","name":"Tarsali, Vadodara"},{"@type":"Place","name":"Karelibaug, Vadodara"},{"@type":"Place","name":"Fatehgunj, Vadodara"},{"@type":"Place","name":"Sayajigunj, Vadodara"},{"@type":"Place","name":"Sama, Vadodara"},{"@type":"Place","name":"Harni, Vadodara"},{"@type":"Place","name":"Nizampura, Vadodara"},{"@type":"Place","name":"Subhanpura, Vadodara"},{"@type":"Place","name":"Gorwa, Vadodara"},{"@type":"Place","name":"Waghodia Road, Vadodara"},{"@type":"Place","name":"Ajwa Road, Vadodara"},{"@type":"Place","name":"Raopura, Vadodara"},{"@type":"Place","name":"Mandvi, Vadodara"},{"@type":"Place","name":"Atladra, Vadodara"}],"potentialAction":{"@type":"OrderAction","target":{"@type":"EntryPoint","urlTemplate":"https://leafli.in/menu","inLanguage":"en-IN","actionPlatform":["https://schema.org/DesktopWebPlatform","https://schema.org/MobileWebPlatform"]},"deliveryMethod":["http://purl.org/goodrelations/v1#DeliveryModeOwnFleet"]},"parentOrganization":{"@id":"https://leafli.in/#organization"}},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Where can I order healthy food in Vadodara?","acceptedAnswer":{"@type":"Answer","text":"Leafli is a Vadodara cloud kitchen that only makes salads and healthy bowls. Order at leafli.in for delivery anywhere in Vadodara, 11 am – 9 pm, every day."}},{"@type":"Question","name":"Do you deliver salads across all of Vadodara?","acceptedAnswer":{"@type":"Answer","text":"Yes — from our kitchen in Akota we deliver across Vadodara city, including Alkapuri, Gotri, Vasna-Bhayli, Manjalpur, Karelibaug, Fatehgunj, Sama, Old Padra Road, Nizampura and Waghodia Road."}},{"@type":"Question","name":"Do you have high-protein vegetarian salads?","acceptedAnswer":{"@type":"Answer","text":"Yes. Our Salad Caprese has around 28 g of protein, and our chana-and-sprout salads use legumes for plant protein. Protein and calories are listed on each dish page."}},{"@type":"Question","name":"Can I get a daily healthy lunch delivered in Vadodara?","acceptedAnswer":{"@type":"Answer","text":"Yes. Our salad subscriptions deliver one fresh bowl per day on the days you choose, for lunch (12–2 pm) or dinner (7–9 pm), with delivery included and the option to pause anytime."}},{"@type":"Question","name":"Is Leafli good for weight loss?","acceptedAnswer":{"@type":"Answer","text":"Our bowls are portion-controlled and list calories, so they are easy to fit into a calorie target. For a personal weight-loss plan, speak to a registered dietitian."}}]}]}7:["$","main",null,{"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$17"}}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d"]}]
