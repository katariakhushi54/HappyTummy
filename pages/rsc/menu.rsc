17:T1c64,{"@context":"https://schema.org","@graph":[{"@type":"Menu","@id":"https://leafli.in/menu#menu","name":"Leafli menu — salads and healthy bowls in Vadodara","url":"https://leafli.in/menu","inLanguage":"en-IN","hasMenuSection":[{"@type":"MenuSection","name":"Protein Salads","hasMenuItem":[{"@type":"MenuItem","@id":"https://leafli.in/menu/classic-chicken-caesar-salad#item","name":"Classic Chicken Caesar Salad","description":"Grilled chicken steak, hard-boiled eggs, crisp lettuce, cherry tomatoes, shaved parmesan and crunchy garlic croutons tossed in a signature Caesar dressing.","url":"https://leafli.in/menu/classic-chicken-caesar-salad","image":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fchicken-caesar.webp?alt=media","nutrition":{"@type":"NutritionInformation","calories":"645 calories"},"offers":{"@type":"Offer","price":550,"priceCurrency":"INR","availability":"https://schema.org/InStock","url":"https://leafli.in/menu/classic-chicken-caesar-salad","areaServed":{"@type":"City","name":"Vadodara","alternateName":"Baroda","containedInPlace":{"@type":"State","name":"Gujarat"}}}}]},{"@type":"MenuSection","name":"Fresh Salads","hasMenuItem":[{"@type":"MenuItem","@id":"https://leafli.in/menu/asian-noodle-salad#item","name":"Asian Noodle Salad","description":"Rice noodles, shredded purple cabbage, carrots, sliced onions, crunchy peanuts, fresh mint and coriander in a toasted sesame-soy vinaigrette.","url":"https://leafli.in/menu/asian-noodle-salad","image":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fasian-rice-noodle.webp?alt=media","suitableForDiet":"https://schema.org/VegetarianDiet","nutrition":{"@type":"NutritionInformation","calories":"435 calories"},"offers":{"@type":"Offer","price":460,"priceCurrency":"INR","availability":"https://schema.org/InStock","url":"https://leafli.in/menu/asian-noodle-salad","areaServed":{"@type":"City","name":"Vadodara","alternateName":"Baroda","containedInPlace":{"@type":"State","name":"Gujarat"}}}},{"@type":"MenuItem","@id":"https://leafli.in/menu/desi-mango-sprout-salad#item","name":"Desi Mango & Sprout Salad","description":"Protein-packed chana and moong sprouts tossed with fresh mango, cucumber, tomatoes, chaat masala and a sweet-spicy mango-jalapeño dressing.","url":"https://leafli.in/menu/desi-mango-sprout-salad","image":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fchana-moong.webp?alt=media","suitableForDiet":"https://schema.org/VegetarianDiet","nutrition":{"@type":"NutritionInformation","calories":"435 calories","proteinContent":"8 g"},"offers":{"@type":"Offer","price":460,"priceCurrency":"INR","availability":"https://schema.org/InStock","url":"https://leafli.in/menu/desi-mango-sprout-salad","areaServed":{"@type":"City","name":"Vadodara","alternateName":"Baroda","containedInPlace":{"@type":"State","name":"Gujarat"}}}},{"@type":"MenuItem","@id":"https://leafli.in/menu/salad-caprese#item","name":"Salad Caprese","description":"Fresh buffalo mozzarella, ripe tomatoes, peppery arugula and basil, drizzled with walnut-basil pesto, balsamic glaze and toasted nuts.","url":"https://leafli.in/menu/salad-caprese","image":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fcaprese.webp?alt=media","suitableForDiet":"https://schema.org/VegetarianDiet","nutrition":{"@type":"NutritionInformation","calories":"650 calories","proteinContent":"28 g"},"offers":{"@type":"Offer","price":550,"priceCurrency":"INR","availability":"https://schema.org/InStock","url":"https://leafli.in/menu/salad-caprese","areaServed":{"@type":"City","name":"Vadodara","alternateName":"Baroda","containedInPlace":{"@type":"State","name":"Gujarat"}}}},{"@type":"MenuItem","@id":"https://leafli.in/menu/greek-hummus-salad#item","name":"Greek Hummus Salad","description":"Creamy house-made hummus topped with crunchy cucumber, lettuce, cherry tomatoes, olives, onion, pomegranate and mint, dusted with za’atar and sumac, finished with sesame oil and crisp lavash.","url":"https://leafli.in/menu/greek-hummus-salad","image":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fgreek-hummus.webp?alt=media","suitableForDiet":"https://schema.org/VegetarianDiet","offers":{"@type":"Offer","price":550,"priceCurrency":"INR","availability":"https://schema.org/InStock","url":"https://leafli.in/menu/greek-hummus-salad","areaServed":{"@type":"City","name":"Vadodara","alternateName":"Baroda","containedInPlace":{"@type":"State","name":"Gujarat"}}}},{"@type":"MenuItem","@id":"https://leafli.in/menu/roasted-potato-apple-salad#item","name":"Roasted Potato & Apple Salad","description":"Herb-roasted potatoes, crisp apples, lettuce, cherry tomatoes and walnuts folded in a tangy French egg gribiche sauce with capers and gherkins.","url":"https://leafli.in/menu/roasted-potato-apple-salad","image":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fpotato-apple.webp?alt=media","nutrition":{"@type":"NutritionInformation","calories":"270 calories","proteinContent":"8 g"},"offers":{"@type":"Offer","price":370,"priceCurrency":"INR","availability":"https://schema.org/InStock","url":"https://leafli.in/menu/roasted-potato-apple-salad","areaServed":{"@type":"City","name":"Vadodara","alternateName":"Baroda","containedInPlace":{"@type":"State","name":"Gujarat"}}}},{"@type":"MenuItem","@id":"https://leafli.in/menu/roasted-potato-apple-salad-eggless#item","name":"Roasted Potato & Apple Salad (Eggless)","description":"Herb-roasted potatoes, crisp apples, lettuce, cherry tomatoes and walnuts with a tangy eggless gribiche made on creamy hung curd, with gherkins and herbs.","url":"https://leafli.in/menu/roasted-potato-apple-salad-eggless","image":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fpotato-apple.webp?alt=media","suitableForDiet":"https://schema.org/VegetarianDiet","offers":{"@type":"Offer","price":370,"priceCurrency":"INR","availability":"https://schema.org/InStock","url":"https://leafli.in/menu/roasted-potato-apple-salad-eggless","areaServed":{"@type":"City","name":"Vadodara","alternateName":"Baroda","containedInPlace":{"@type":"State","name":"Gujarat"}}}}]},{"@type":"MenuSection","name":"Fruit & Dessert Bowls","hasMenuItem":[{"@type":"MenuItem","@id":"https://leafli.in/menu/dark-chocolate-fruit-bowl#item","name":"Dark Chocolate Fruit Bowl","description":"Velvety hung curd blended with dark chocolate compound, cocoa, orange zest and honey, topped with seasonal exotic fruits and granola or nuts.","url":"https://leafli.in/menu/dark-chocolate-fruit-bowl","image":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fchocolate-fruit-bowl.webp?alt=media","suitableForDiet":"https://schema.org/VegetarianDiet","nutrition":{"@type":"NutritionInformation","calories":"400 calories","proteinContent":"9 g"},"offers":{"@type":"Offer","price":370,"priceCurrency":"INR","availability":"https://schema.org/InStock","url":"https://leafli.in/menu/dark-chocolate-fruit-bowl","areaServed":{"@type":"City","name":"Vadodara","alternateName":"Baroda","containedInPlace":{"@type":"State","name":"Gujarat"}}}}]}]}]}7:["$","main",null,{"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$17"}}],"$L18","$L19"]}]
