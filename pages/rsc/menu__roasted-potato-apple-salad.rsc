6:["$","$L14",null,{"initialMenu":{"acceptingOrders":true,"orderingHours":{"opens":"11:00","closes":"20:00"},"razorpayKeyId":"rzp_live_TrpPs1JknB3nDC","gstRate":5,"packagingChargePerOrder":0,"deliveryCharge":0,"items":[{"id":"chicken-caesar","slug":"classic-chicken-caesar-salad","name":"Classic Chicken Caesar Salad","description":"Grilled chicken steak, hard-boiled eggs, crisp lettuce, cherry tomatoes, shaved parmesan and crunchy garlic croutons tossed in a signature Caesar dressing.","category":"Protein Salads","price":550,"imageUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fchicken-caesar-cutout.webp?alt=media","photoUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fchicken-caesar.webp?alt=media","ogImageUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fchicken-caesar-og.jpg?alt=media","available":true,"diet":"nonveg","allergens":["egg","milk","mustard","gluten"],"nutrition":{"calories":645},"ingredients":["Grilled chicken steak","Hard-boiled eggs","Lettuce","Cherry tomatoes","Parmesan cheese","Garlic croutons","Caesar dressing"]},{"id":"asian-rice-noodle","slug":"asian-noodle-salad","name":"Asian Noodle Salad","description":"Rice noodles, shredded purple cabbage, carrots, sliced onions, crunchy peanuts, fresh mint and coriander in a toasted sesame-soy vinaigrette.","category":"Fresh Salads","price":460,"imageUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fasian-rice-noodle-cutout.webp?alt=media","photoUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fasian-rice-noodle.webp?alt=media","ogImageUrl":"https://firebasestorage.googleapis.com/v0/b/leafli-243ae.firebasestorage.app/o/menu%2Fasian-rice-noodle-og.jpg?alt=media","available":true,"diet":"veg","allergens":["soy","sesame","peanuts"],"nutrition":{"calories":435},"ingredients":["Rice noodles","Purple c