b:{"metadata":[["$","title","0",{"children":"Salad Subscription in Vadodara — Weekly & Monthly | Leafli"}],["$","meta","1",{"name":"description","content":"Weekly, fortnightly and monthly salad subscriptions in Vadodara from ₹375 per bowl, delivery included. Pick your days, swap bowls and pause anytime."}],["$","meta","2",{"name":"application-name","content":"Leafli"}],["$","link","3",{"rel":"manifest","href":"/manifest.webmanifest","crossOrigin":"$undefined"}],["$","meta","4",{"name":"robots","content":"index, follow"}],["$","meta","5",{"name":"googlebot","content":"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"}],["$","meta","6",{"name":"mobile-web-app-capable","content":"yes"}],["$","meta","7",{"name":"geo.region","content":"IN-GJ"}],["$","meta","8",{"name":"geo.placename","content":"Vadodara"}],["$","link","9",{"rel":"canonical","href":"https://leafli.in/plans"}],["$","meta","10",{"name":"format-detection","content":"telephone=no, address=no, email=no"}],["$","meta","11",{"name":"mobile-web-app-capable","content":"yes"}],["$","meta","12",{"name":"apple-mobile-web-app-title","content":"Leafli"}],["$","meta","13",{"name":"apple-mobile-web-app-status-bar-style","content":"default"}],["$","meta","14",{"property":"og:title","content":"Leafli — Fresh bowls. Happy moods. · Vadodara"}],["$","meta","15",{"property":"og:description","content":"Chef-made salads and healthy bowls delivered fresh across Vadodara, dressings on the side. Order online 11 am–9 pm or subscribe and save up to 22%."}],["$","meta","16",{"property":"og:url","content":"https://leafli.in"}],["$","meta","17",{"property":"og:site_name","content":"Leafli"}],["$","meta","18",{"property":"og:locale","content":"en_IN"}],["$","meta","19",{"property":"og:image:alt","content":"Leafli — Fresh bowls. Happy moods."}],["$","meta","20",{"property":"og:image:type","content":"image/png"}],["$","meta","21",{"property":"og:image","content":"https://leafli.in/opengraph-image?26404f8a5199256