17:T1257,{"@context":"https://schema.org","@graph":[{"@type":"Product","@id":"https://leafli.in/plans/taster-week#product","name":"Taster Week — Leafli salad subscription, Vadodara","description":"New to Leafli? Five weekday lunches that rotate through our salads so you can find your favourites. Pick your own bowl for any day, or let the chef surprise you.","brand":{"@type":"Brand","name":"Leafli"},"category":"Meal subscription","image":"https://leafli.in/brand/leafli-logo.png","offers":{"@type":"Offer","price":2099,"priceCurrency":"INR","availability":"https://schema.org/InStock","url":"https://leafli.in/plans/taster-week","areaServed":{"@type":"City","name":"Vadodara","alternateName":"Baroda","containedInPlace":{"@type":"State","name":"Gujarat"}},"seller":{"@id":"https://leafli.in/#organization"}}},{"@type":"Product","@id":"https://leafli.in/plans/fortnight-fresh#product","name":"Fortnight Fresh — Leafli salad subscription, Vadodara","description":"Two weeks of lunches sorted. Twelve fresh bowls across six days a week, with dressings packed on the side so every salad arrives crisp.","brand":{"@type":"Brand","name":"Leafli"},"category":"Meal subscription","image":"https://leafli.in/brand/leafli-logo.png","offers":{"@type":"Offer","price":4799,"priceCurrency":"INR","availability":"https://schema.org/InStock","url":"https://leafli.in/plans/fortnight-fresh","areaServed":{"@type":"City","name":"Vadodara","alternateName":"Baroda","containedInPlace":{"@type":"State","name":"Gujarat"}},"seller":{"@id":"https://leafli.in/#organization"}}},{"@type":"Product","@id":"https://leafli.in/plans/monthly-green#product","name":"Monthly Green — Leafli salad subscription, Vadodara","description":"A month of healthy eating on autopilot. Twenty-four bowls at our lowest price per bowl, with priority delivery slots and the full salad menu to choose from.","brand":{"@type":"Brand","name":"Leafli"},"category":"Meal subscription","image":"https://leafli.in/brand/leafli-logo.png","offers":{"@type":"Offer","price":8999,"priceCurrency":"INR","availability":"https://schema.org/InStock","url":"https://leafli.in/plans/monthly-green","areaServed":{"@type":"City","name":"Vadodara","alternateName":"Baroda","containedInPlace":{"@type":"State","name":"Gujarat"}},"seller":{"@id":"https://leafli.in/#organization"}}},{"@type":"Product","@id":"https://leafli.in/plans/protein-pro#product","name":"Protein Pro — Leafli salad subscription, Vadodara","description":"Built for training days. Rotates our most protein-rich bowls — Classic Chicken Caesar, Salad Caprese with buffalo mozzarella, and the Desi Mango & Sprout Salad.","brand":{"@type":"Brand","name":"Leafli"},"category":"Meal subscription","image":"https://leafli.in/brand/leafli-logo.png","offers":{"@type":"Offer","price":8799,"priceCurrency":"INR","availability":"https://schema.org/InStock","url":"https://leafli.in/plans/protein-pro","areaServed":{"@type":"City","name":"Vadodara","alternateName":"Baroda","containedInPlace":{"@type":"State","name":"Gujarat"}},"seller":{"@id":"https://leafli.in/#organization"}}},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How does a Leafli salad subscription work?","acceptedAnswer":{"@type":"Answer","text":"Pick a plan, your delivery days and lunch or dinner slot. We deliver one fresh bowl on each delivery day until your bowls are used. Choose your bowl for any day from your account, or let the chef rotate the menu for you."}},{"@type":"Question","name":"Can I pause, skip or change my bowl?","acceptedAnswer":{"@type":"Answer","text":"Yes — skip a day, pause your whole plan, or swap the bowl for any upcoming day until 9 pm the day before. Pausing extends your plan's validity by the days you paused."}},{"@type":"Question","name":"Is delivery included?","acceptedAnswer":{"@type":"Answer","text":"Yes. Every plan includes delivery to your home or office anywhere in Vadodara on your chosen days — lunch between 12 and 2 pm or dinner between 7 and 9 pm."}},{"@type":"Question","name":"Which areas of Vadodara do subscriptions cover?","acceptedAnswer":{"@type":"Answer","text":"All of Vadodara city — Akota, Alkapuri, Gotri, Vasna-Bhayli, Manjalpur, Karelibaug, Fatehgunj, Sama, Old Padra Road, Waghodia Road and everywhere in between."}},{"@type":"Question","name":"Do you have vegetarian subscriptions?","acceptedAnswer":{"@type":"Answer","text":"Yes. Choose vegetarian, eggetarian or non-vegetarian when you subscribe and we'll only send bowls that match."}},{"@type":"Question","name":"How do I pay?","acceptedAnswer":{"@type":"Answer","text":"Pay securely online with UPI, cards, netbanking or wallets via Razorpay. You get a GST invoice for your plan."}}]}]}7:["$","main",null,{"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$17"}}],"$L18","$L19","$L1a","$L1b"]}]
