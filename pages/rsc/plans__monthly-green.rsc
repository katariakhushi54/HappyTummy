22:["$","div",null,{"id":"subscribe","className":"scroll-mt-20 lg:sticky lg:top-28 lg:self-start","children":["$","$L29",null,{"plan":{"slug":"monthly-green","name":"Monthly Green","tagline":"24 bowls · our best price per bowl","description":"A month of healthy eating on autopilot. Twenty-four bowls at our lowest price per bowl, with priority delivery slots and the full salad menu to choose from.","meals":24,"validityDays":40,"price":8999,"compareAtPrice":11472,"eligibleMenuIds":[],"freeDelivery":true,"features":["24 chef-made bowls","Use within 40 days","Delivery included","Priority delivery slot","Pause, skip or swap bowls anytime"],"highlight":"Best value","active":true,"sortOrder":3,"faqs":[{"q":"Can I choose which salad I get each day?","a":"Yes. Pick a bowl for any upcoming day from your account until 9 pm the day before. If you don't choose, the chef rotates through the bowls in your plan."},{"q":"Can I pause or skip deliveries?","a":"Yes. Skip a single day or pause the whole plan from your account before 9 pm the day before. Skipped meals stay in your balance until the plan's validity ends."},{"q":"What if I don't use all my bowls?","a":"Bowls must be used within 40 days of your start date. Unused bowls after that expire, so set your delivery days to match your routine."},{"q":"Do you cater to vegetarians?","a":"Yes. Choose a vegetarian, eggetarian or non-vegetarian preference and we'll only send bowls that match."}],"metaTitle":"Monthly Green — 24-Bowl Salad Plan in Vadodara | Leafli","metaDescription":"24 bowls · our best price per bowl. Chef-made salads delivered across Vadodara, dressings on the side. ₹375 per bowl, delivery included.","updatedAt":1792942961274,"id":"monthly-green"},"acceptsOnline":true,"razorpayKeyId":"rzp_live_TrpPs1JknB3nDC","gstRate":5}]}]
