15:T726,{"@context":"https://schema.org","@graph":[{"@type":"Product","@id":"https://leafli.in/plans/monthly-green#product","name":"Monthly Green — Leafli salad subscription, Vadodara","description":"A month of healthy eating on autopilot. Twenty-four bowls at our lowest price per bowl, with priority delivery slots and the full salad menu to choose from.","brand":{"@type":"Brand","name":"Leafli"},"category":"Meal subscription","image":"https://leafli.in/brand/leafli-logo.png","offers":{"@type":"Offer","price":8999,"priceCurrency":"INR","availability":"https://schema.org/InStock","url":"https://leafli.in/plans/monthly-green","areaServed":{"@type":"City","name":"Vadodara","alternateName":"Baroda","containedInPlace":{"@type":"State","name":"Gujarat"}},"seller":{"@id":"https://leafli.in/#organization"}}},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can I choose which salad I get each day?","acceptedAnswer":{"@type":"Answer","text":"Yes. Pick a bowl for any upcoming day from your account until 9 pm the day before. If you don't choose, the chef rotates through the bowls in your plan."}},{"@type":"Question","name":"Can I pause or skip deliveries?","acceptedAnswer":{"@type":"Answer","text":"Yes. Skip a single day or pause the whole plan from your account before 9 pm the day before. Skipped meals stay in your balance until the plan's validity ends."}},{"@type":"Question","name":"What if I don't use all my bowls?","acceptedAnswer":{"@type":"Answer","text":"Bowls must be used within 40 days of your start date. Unused bowls after that expire, so set your delivery days to match your routine."}},{"@type":"Question","name":"Do you cater to vegetarians?","acceptedAnswer":{"@type":"Answer","text":"Yes. Choose a vegetarian, eggetarian or non-vegetarian preference and we'll only send bowls that match."}}]}]}7:["$","main",null,{"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$15"}}],["$","header",null,{"className":"grain